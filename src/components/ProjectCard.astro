---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  stack: string[];
  status: 'actif' | 'en cours' | 'archivé';
  thumbnail?: ImageMetadata;
  githubUrl?: string;
  demoUrl?: string;
}
const { slug, title, summary, stack, status, thumbnail } = Astro.props as Props;

const statusClass = {
  actif: 'status--actif',
  'en cours': 'status--en-cours',
  archivé: 'status--archive',
}[status];

// Category color theme for top accent line
const isSecurity = stack.some(s => ['ISO/SAE 21434', 'TARA', 'CAN Bus', 'SocketCAN', 'ICSim'].includes(s));
const isWeb = stack.some(s => ['Next.js', 'React', 'Node.js', 'Supabase'].includes(s));

const cardAccentClass = isSecurity 
  ? 'card-accent--cyan' 
  : isWeb 
  ? 'card-accent--pink' 
  : 'card-accent--amber';

const langColors: Record<string, string> = {
  'Python': '#38bdf8',
  'Next.js': '#ec4899',
  'React': '#61dafb',
  'Node.js': '#10b981',
  'Supabase': '#3ecf8e',
  'Firebase': '#f59e0b',
  'Docker Compose': '#8b5cf6',
  'ISO/SAE 21434': '#00f2fe',
  'TARA': '#00f2fe',
  'CAN Bus': '#00f2fe',
  'SocketCAN': '#38bdf8',
};
const primaryStack = stack[0];
const dotColor = langColors[primaryStack] ?? '#00f2fe';
---

<a class={`sheet ${cardAccentClass}`} href={`/projets/${slug}`} data-status={status} data-category={isSecurity ? 'cyber' : isWeb ? 'web' : 'other'}>
  {thumbnail ? (
    <Image src={thumbnail} alt={title} width={640} height={320} class="sheet__thumb" />
  ) : (
    <div class="sheet__banner-placeholder">
      <div class="sheet__banner-title">{title}</div>
      <div class="sheet__banner-tag">{primaryStack || 'Cybersecurity'}</div>
    </div>
  )}
  
  <div class="sheet__content">
    <div class="sheet__top">
      <h3>{title}</h3>
      <span class={`status ${statusClass}`}>
        <span class="dot" style={`background:${status === 'actif' ? '#10b981' : status === 'en cours' ? '#f59e0b' : '#64748b'}`}></span>
        {status}
      </span>
    </div>
    
    <p class="sheet__summary">{summary}</p>
    
    <div class="sheet__footer">
      <div class="sheet__meta">
        {primaryStack && (
          <span><span class="lang-dot" style={`background:${dotColor}`}></span>{primaryStack}</span>
        )}
        {stack.slice(1, 3).map((s) => <span class="tag">{s}</span>)}
      </div>

      <span class="sheet__action-link">
        <span>Consulter</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </span>
    </div>
  </div>
</a>
