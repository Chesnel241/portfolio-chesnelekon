---
// src/components/IsoRoadInteractive.astro
---

<div class="iso-cad-container" id="isoRoadContainer">
  <!-- Automotive R&D Test Bench Header -->
  <div class="iso-cad-header">
    <div class="cad-title-group">
      <div class="cad-badge">CYCLE V-MODEL ISO 21434</div>
      <h3 class="cad-heading">Banc de Validation & Traçabilité Véhicule</h3>
    </div>
    
    <div class="cad-bench-telemetry">
      <div class="telemetry-item">
        <span class="telemetry-label">CIBLE ECU</span>
        <span class="telemetry-val">Domain Controller (AUTOSAR AP)</span>
      </div>
      <div class="telemetry-item hide-mobile">
        <span class="telemetry-label">JALON PROJET</span>
        <span class="telemetry-val telemetry-val--cyan" id="hudCadJalon">SEC0 → SEC5</span>
      </div>
      <div class="telemetry-item">
        <span class="telemetry-label">CONFORMITÉ</span>
        <span class="telemetry-val telemetry-val--green" id="hudCadStatus">UNECE R155 READY</span>
      </div>
    </div>

    <!-- Circular Play / Pause Control Button -->
    <div class="cad-play-control-wrapper">
      <button type="button" class="btn-cad-play-circle" id="btnAutoDrive" aria-label="Lancer ou mettre en pause la simulation ISO 21434">
        <span class="pulse-ring"></span>
        <!-- Play Icon (Default) -->
        <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="6 3 20 12 6 21 6 3"></polygon>
        </svg>
        <!-- Pause Icon (Active) -->
        <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
          <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
          <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
        </svg>
      </button>
      <span class="btn-play-label" id="btnDriveLabel">Lancer la simulation</span>
    </div>
  </div>

  <!-- 3D Isometric CAD Road Viewport -->
  <div class="iso-3d-viewport">
    <svg class="iso-3d-svg" viewBox="0 0 960 320" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- CAD Isometric Grid Pattern -->
        <pattern id="cadGridPattern" width="40" height="20" patternUnits="userSpaceOnUse">
          <path d="M 0 10 L 40 10 M 20 0 L 20 20" stroke="rgba(255, 255, 255, 0.03)" stroke-width="1"/>
        </pattern>
        <!-- Road Gradient -->
        <linearGradient id="roadGradient3D" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#0f172a"/>
          <stop offset="50%" stop-color="#1e293b"/>
          <stop offset="100%" stop-color="#0f172a"/>
        </linearGradient>
        <!-- Metallic Edge Gradient -->
        <linearGradient id="edgeGradient3D" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#334155"/>
          <stop offset="50%" stop-color="#0ea5e9"/>
          <stop offset="100%" stop-color="#334155"/>
        </linearGradient>
      </defs>

      <!-- Background CAD Grid Surface -->
      <rect width="960" height="320" fill="url(#cadGridPattern)"/>

      <!-- 3D Perspective Highway Ribbon Polygon -->
      <polygon points="40,240 920,240 940,160 60,160" fill="url(#roadGradient3D)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1"/>
      
      <!-- Road Outer Metallic Borders -->
      <line x1="60" y1="160" x2="940" y2="160" stroke="url(#edgeGradient3D)" stroke-width="2"/>
      <line x1="40" y1="240" x2="920" y2="240" stroke="url(#edgeGradient3D)" stroke-width="2"/>

      <!-- Center Lane Dashed Guidelines (3D Perspective) -->
      <line x1="50" y1="200" x2="930" y2="200" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="16 12" stroke-opacity="0.3"/>

      <!-- Active Trailing Laser Progress Line -->
      <line id="cadTrailingLine" x1="140" y1="200" x2="140" y2="200" stroke="#0ea5e9" stroke-width="2.5" stroke-linecap="round"/>

      <!-- Guideline Projection Drop Lines to Baseline -->
      <line x1="140" y1="200" x2="140" y2="280" stroke="rgba(255, 255, 255, 0.1)" stroke-dasharray="2 2"/>
      <line x1="380" y1="200" x2="380" y2="280" stroke="rgba(255, 255, 255, 0.1)" stroke-dasharray="2 2"/>
      <line x1="620" y1="200" x2="620" y2="280" stroke="rgba(255, 255, 255, 0.1)" stroke-dasharray="2 2"/>
      <line x1="840" y1="200" x2="840" y2="280" stroke="rgba(255, 255, 255, 0.1)" stroke-dasharray="2 2"/>

      <!-- Checkpoint 01: Item Definition -->
      <g class="cad-node-group active" id="nodeGroup1" data-step="0" transform="translate(140, 200)">
        <line x1="0" y1="0" x2="0" y2="-90" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="3 3"/>
        <circle class="node-dot" cx="0" cy="0" r="6" fill="#0f172a" stroke="#0ea5e9" stroke-width="2"/>
        <circle class="node-pulse-ring" cx="0" cy="0" r="14" fill="none" stroke="#0ea5e9" stroke-width="1" stroke-opacity="0.4"/>
        <g class="node-card-box" transform="translate(0, -90)">
          <rect x="-60" y="-24" width="120" height="28" rx="4" fill="#0f172a" stroke="#0ea5e9" stroke-width="1.5"/>
          <text x="0" y="-6" fill="#f8fafc" font-size="11" font-weight="700" text-anchor="middle" font-family="sans-serif">01. ITEM DEF</text>
          <text x="0" y="14" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="monospace">SEC0 / CARTOGRAPHIE</text>
        </g>
      </g>

      <!-- Checkpoint 02: TARA Analysis -->
      <g class="cad-node-group" id="nodeGroup2" data-step="1" transform="translate(380, 200)">
        <line x1="0" y1="0" x2="0" y2="-90" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3 3"/>
        <circle class="node-dot" cx="0" cy="0" r="6" fill="#0f172a" stroke="#64748b" stroke-width="2"/>
        <circle class="node-pulse-ring" cx="0" cy="0" r="14" fill="none" stroke="#64748b" stroke-width="1" stroke-opacity="0" style="transition: all 0.3s;"/>
        <g class="node-card-box" transform="translate(0, -90)">
          <rect x="-60" y="-24" width="120" height="28" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
          <text x="0" y="-6" fill="#f8fafc" font-size="11" font-weight="700" text-anchor="middle" font-family="sans-serif">02. TARA</text>
          <text x="0" y="14" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="monospace">SEC2 / RISQUES</text>
        </g>
      </g>

      <!-- Checkpoint 03: Requirements & SecOC -->
      <g class="cad-node-group" id="nodeGroup3" data-step="2" transform="translate(620, 200)">
        <line x1="0" y1="0" x2="0" y2="-90" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3 3"/>
        <circle class="node-dot" cx="0" cy="0" r="6" fill="#0f172a" stroke="#64748b" stroke-width="2"/>
        <circle class="node-pulse-ring" cx="0" cy="0" r="14" fill="none" stroke="#64748b" stroke-width="1" stroke-opacity="0" style="transition: all 0.3s;"/>
        <g class="node-card-box" transform="translate(0, -90)">
          <rect x="-60" y="-24" width="120" height="28" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
          <text x="0" y="-6" fill="#f8fafc" font-size="11" font-weight="700" text-anchor="middle" font-family="sans-serif">03. ARCHITECTURE</text>
          <text x="0" y="14" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="monospace">SEC4 / SECOC & HSM</text>
        </g>
      </g>

      <!-- Checkpoint 04: CSMS & UNECE R155/R156 -->
      <g class="cad-node-group" id="nodeGroup4" data-step="3" transform="translate(840, 200)">
        <line x1="0" y1="0" x2="0" y2="-90" stroke="#64748b" stroke-width="1.5" stroke-dasharray="3 3"/>
        <circle class="node-dot" cx="0" cy="0" r="6" fill="#0f172a" stroke="#64748b" stroke-width="2"/>
        <circle class="node-pulse-ring" cx="0" cy="0" r="14" fill="none" stroke="#64748b" stroke-width="1" stroke-opacity="0" style="transition: all 0.3s;"/>
        <g class="node-card-box" transform="translate(0, -90)">
          <rect x="-60" y="-24" width="120" height="28" rx="4" fill="#0f172a" stroke="#334155" stroke-width="1.5"/>
          <text x="0" y="-6" fill="#f8fafc" font-size="11" font-weight="700" text-anchor="middle" font-family="sans-serif">04. HOMOLOGATION</text>
          <text x="0" y="14" fill="#94a3b8" font-size="9" text-anchor="middle" font-family="monospace">SEC5 / CSMS UNECE</text>
        </g>
      </g>

      <!-- 3D Vector CAD Vehicle Model (Top 3/4 Isometric Perspective) -->
      <g id="cadVehicle3D" transform="translate(140, 200)">
        <!-- Vehicle Shadow -->
        <ellipse cx="0" cy="8" rx="42" ry="12" fill="rgba(0, 0, 0, 0.6)"/>
        
        <!-- Precision 3D Vector Car Chassis Wireframe/Solid -->
        <!-- Main Body Hull -->
        <path d="M -38 -6 L -20 -16 L 15 -16 L 38 -6 L 36 6 L -20 10 L -38 -6 Z" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5"/>
        
        <!-- Roof Cockpit Glass -->
        <path d="M -12 -14 L 5 -14 L 18 -8 L 2 -6 L -12 -14 Z" fill="#0284c7" fill-opacity="0.3" stroke="#38bdf8" stroke-width="1"/>

        <!-- Hood Technical Precision Lines -->
        <line x1="15" y1="-16" x2="38" y2="-6" stroke="#0ea5e9" stroke-width="1"/>
        <line x1="20" y1="-10" x2="34" y2="-5" stroke="#38bdf8" stroke-width="1"/>

        <!-- Wheel Hub Highlights (Isometric Perspective) -->
        <ellipse cx="-22" cy="8" rx="7" ry="4" fill="#0f172a" stroke="#38bdf8" stroke-width="1"/>
        <ellipse cx="22" cy="6" rx="7" ry="4" fill="#0f172a" stroke="#38bdf8" stroke-width="1"/>

        <!-- Laser Headlight Beam (Clean White/Cyan Vector Beam) -->
        <polygon points="38,-6 75,-14 78,8 36,6" fill="rgba(56, 189, 248, 0.12)"/>
        <line x1="38" y1="-6" x2="75" y2="-14" stroke="rgba(56, 189, 248, 0.4)" stroke-width="1"/>
        <line x1="36" y1="6" x2="78" y2="8" stroke="rgba(56, 189, 248, 0.4)" stroke-width="1"/>

        <!-- Telemetry Data Overlay Pin -->
        <circle cx="0" cy="-22" r="3" fill="#22c55e"/>
      </g>
    </svg>
  </div>

  <!-- Active Milestone Deliverables Panel -->
  <div class="cad-stage-panel" id="cadDeliverablesPanel">
    <!-- Populated via Javascript -->
  </div>
</div>

<style>
  .iso-cad-container {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-top: 1.5rem;
    box-shadow: var(--card-shadow);
  }

  /* Header Bench Bar */
  .iso-cad-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-soft);
    flex-wrap: wrap;
  }

  .cad-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cad-badge {
    font-size: 0.65rem;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .cad-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .cad-bench-telemetry {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .telemetry-label {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  .telemetry-val {
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--ink);
  }

  .telemetry-val--cyan {
    color: var(--accent-cyan);
  }

  .telemetry-val--green {
    color: var(--accent-green);
  }

  /* Circular Play / Pause Control Button (Apple Blue) */
  .cad-play-control-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-cad-play-circle {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #0071e3;
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: none;
    padding: 0;
  }

  .btn-cad-play-circle:hover {
    transform: scale(1.06);
    background: #0077ed;
    color: #ffffff;
    box-shadow: none;
  }

  .btn-cad-play-circle:active {
    transform: scale(0.96);
  }

  .btn-cad-play-circle.playing .pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--accent-cyan);
    animation: pulseRing 1.8s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    pointer-events: none;
  }

  @keyframes pulseRing {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  .btn-play-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .btn-cad-play-circle:hover + .btn-play-label,
  .btn-cad-play-circle.playing + .btn-play-label {
    color: var(--accent-cyan);
  }

  /* 3D Viewport Adaptive Surface */
  .iso-3d-viewport {
    position: relative;
    width: 100%;
    background: #070a12;
    border: 1px solid rgba(56, 189, 248, 0.15);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.5rem;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  :global([data-theme="light"]) .iso-3d-viewport {
    background: #f1f5f9;
    border-color: rgba(2, 132, 199, 0.2);
  }

  .iso-3d-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .cad-node-group {
    cursor: pointer;
  }

  .cad-node-group:hover .node-dot,
  .cad-node-group.active .node-dot {
    fill: #0ea5e9;
    stroke: #38bdf8;
  }

  .cad-node-group:hover .node-pulse-ring,
  .cad-node-group.active .node-pulse-ring {
    stroke-opacity: 0.8;
    stroke: #38bdf8;
  }

  .cad-node-group:hover rect,
  .cad-node-group.active rect {
    stroke: #0ea5e9;
    fill: #1e293b;
  }

  :global([data-theme="light"]) .cad-node-group rect {
    fill: #ffffff;
    stroke: #cbd5e1;
  }

  :global([data-theme="light"]) .cad-node-group text:nth-of-type(1) {
    fill: #0f172a;
  }

  :global([data-theme="light"]) .cad-node-group text:nth-of-type(2) {
    fill: #475569;
  }

  :global([data-theme="light"]) .cad-node-group:hover rect,
  :global([data-theme="light"]) .cad-node-group.active rect {
    stroke: #0284c7;
    fill: #e0f2fe;
  }

  /* Deliverables Panel */
  .cad-stage-panel {
    background: var(--chip-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .cad-stage-panel.updating {
    opacity: 0.4;
    transform: translateY(4px);
  }

  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }
  }
</style>

<script>
  interface CadStep {
    step: number;
    secJalon: string;
    title: string;
    positionX: number; // X coordinate on SVG
    status: string;
    description: string;
    deliverables: string[];
    standardRef: string;
  }

  const cadSteps: CadStep[] = [
    {
      step: 0,
      secJalon: "SEC0 / JALON CONCEPT",
      title: "Phase 01 : Spécification du Périmètre & Cartographie des Assets",
      positionX: 140,
      status: "SEC0 PASSED",
      standardRef: "ISO/SAE 21434 Clause 9",
      description: "Définition rigoureuse du sous-système embarqué (Domain Controller / Gateway ECU). Inventaire des bus réseau (CAN-FD, LIN, Automotive Ethernet) et classification des propriétés de sécurité à protéger (Confidentialité, Intégrité, Authenticité).",
      deliverables: [
        "Spécification du périmètre système (Item Definition Document)",
        "Cartographie des interfaces physiques et logiques (OBD-II, UDS, OTA)",
        "Identification des exigences de sécurité de haut niveau (CIA)"
      ]
    },
    {
      step: 1,
      secJalon: "SEC2 / JALON RISQUES",
      title: "Phase 02 : Analyse des Menaces & Évaluation des Risques (TARA)",
      positionX: 380,
      status: "SEC2 PASSED",
      standardRef: "ISO/SAE 21434 Clause 15 & Annex H",
      description: "Identification exhaustive des scénarios de menaces et modélisation des chemins d'attaque (Attack Trees). Évaluation de la faisabilité d'attaque (Expertise, Équipement, Fenêtre d'opportunité) et détermination des niveaux d'impact (Safety ISO 26262, Financial, Operational, Privacy).",
      deliverables: [
        "Rapport complet TARA (Threat Analysis and Risk Assessment)",
        "Calcul des niveaux de risque et déduction des Cybersecurity Goals (CSG)",
        "Définition des limites d'acceptabilité du risque selon le profil de la flotte"
      ]
    },
    {
      step: 2,
      secJalon: "SEC4 / JALON ARCHITECTURE",
      title: "Phase 03 : Exigences de Sécurité & Architecture SecOC / HSM",
      positionX: 620,
      status: "SEC4 PASSED",
      standardRef: "ISO/SAE 21434 Clause 10",
      description: "Traduction des Cybersecurity Goals en exigences techniques de sécurité (Cybersecurity Requirements). Conception d'une architecture embarquée robuste intégrant le démarrage sécurisé (Secure Boot), la communication CAN-FD authentifiée (SecOC) et l'isolation matérielle HSM/SHE.",
      deliverables: [
        "Traçabilité 100% dans Polarion/JIRA (CSG → Requirement → Test Spec)",
        "Spécification logicielle SecOC (MAC Freshness Value Manager - FVM)",
        "Configuration des modules cryptographiques HSM (Hardware Security Module)"
      ]
    },
    {
      step: 3,
      secJalon: "SEC5 / JALON HOMOLOGATION",
      title: "Phase 04 : Qualification Fuzzing & Homologation CSMS (UNECE R155/R156)",
      positionX: 840,
      status: "SEC5 PASSED",
      standardRef: "UNECE R155 / R156 & ISO 21434 Clause 11",
      description: "Validation expérimentale sur banc de test et véhicule complet. Campagnes de Fuzzing CAN/UDS, tests de pénétration calculateurs et constitution du dossier de preuves réglementaires pour la certification du système de gestion (CSMS & SUMS).",
      deliverables: [
        "Rapports de Pentest embarqué et bancs de Fuzzing CAN/UDS",
        "Dossier de preuve d'homologation réglementaire (UNECE R155 CSMS / UNECE R156 SUMS)",
        "Plan de réponse aux vulnérabilités en flotte (Cybersecurity Incident Response Plan)"
      ]
    }
  ];

  let currentStep = 0;
  let isPlaying = false;
  let animFrameId: number | null = null;
  let currentPosX = 140;
  let targetPosX = 140;

  function setVehiclePositionSmooth(targetX: number, duration: number = 800) {
    const startX = currentPosX;
    const startTime = performance.now();

    if (animFrameId) cancelAnimationFrame(animFrameId);

    function stepAnim(time: number) {
      const elapsed = time - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // Smooth Easing (cubic-bezier ease-out curve)
      const ease = 1 - Math.pow(1 - progress, 3);
      currentPosX = startX + (targetX - startX) * ease;

      // Micro Pitch Angle during movement
      const isMoving = Math.abs(targetX - currentPosX) > 1;
      const pitchAngle = isMoving ? (targetX > startX ? -1.2 : 1.2) : 0;

      // Update Vehicle Position in SVG
      const vehicle = document.getElementById('cadVehicle3D');
      if (vehicle) {
        vehicle.setAttribute('transform', `translate(${currentPosX.toFixed(2)}, 200) rotate(${pitchAngle})`);
      }

      // Update Laser Trailing Line
      const trailingLine = document.getElementById('cadTrailingLine');
      if (trailingLine) {
        trailingLine.setAttribute('x2', currentPosX.toFixed(2));
      }

      if (progress < 1) {
        animFrameId = requestAnimationFrame(stepAnim);
      } else {
        currentPosX = targetX;
        if (vehicle) {
          vehicle.setAttribute('transform', `translate(${targetX}, 200) rotate(0)`);
        }
      }
    }

    animFrameId = requestAnimationFrame(stepAnim);
  }

  function renderCadStep(index: number) {
    const data = cadSteps[index];
    if (!data) return;

    currentStep = index;
    targetPosX = data.positionX;

    // Smooth Vehicle Movement
    setVehiclePositionSmooth(targetPosX, 750);

    // Update Node Groups Highlight
    [1, 2, 3, 4].forEach((num, i) => {
      const nodeGrp = document.getElementById(`nodeGroup${num}`);
      if (nodeGrp) {
        if (i === index) {
          nodeGrp.classList.add('active');
          const line = nodeGrp.querySelector('line');
          if (line) line.setAttribute('stroke', '#0ea5e9');
        } else {
          nodeGrp.classList.remove('active');
          const line = nodeGrp.querySelector('line');
          if (line) line.setAttribute('stroke', '#64748b');
        }
      }
    });

    // Update Header Telemetry
    const jalonElem = document.getElementById('hudCadJalon');
    if (jalonElem) jalonElem.textContent = data.secJalon;

    // Render Deliverables Panel with Smooth Fade Transition
    const panel = document.getElementById('cadDeliverablesPanel');
    if (panel) {
      panel.classList.add('updating');
      setTimeout(() => {
        panel.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
            <div>
              <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-cyan); letter-spacing: 0.08em; text-transform: uppercase;">${data.standardRef}</span>
              <h4 style="font-size: 1.1rem; color: var(--text-main); margin: 0.2rem 0 0 0;">${data.title}</h4>
            </div>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-green); background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); padding: 0.25rem 0.6rem; border-radius: 4px;">${data.status}</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.1rem;">${data.description}</p>
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem;">Livrables de Validation d'Ingénierie :</div>
            <ul style="display: grid; gap: 0.45rem; padding-left: 1.2rem; color: var(--text-muted); font-size: 0.86rem;">
              ${data.deliverables.map(item => `<li>${item}</li>`).join('')}
            </ul>
          </div>
        `;
        panel.classList.remove('updating');
      }, 120);
    }
  }

  let playLoopInterval: any = null;

  function togglePlayPauseState(play?: boolean) {
    const btn = document.getElementById('btnAutoDrive');
    const label = document.getElementById('btnDriveLabel');
    const iconPlay = btn?.querySelector('.icon-play') as HTMLElement;
    const iconPause = btn?.querySelector('.icon-pause') as HTMLElement;

    if (play === undefined) {
      isPlaying = !isPlaying;
    } else {
      isPlaying = play;
    }

    if (isPlaying) {
      btn?.classList.add('playing');
      if (iconPlay) iconPlay.style.display = 'none';
      if (iconPause) iconPause.style.display = 'block';
      if (label) label.textContent = 'Pause simulation';

      let next = (currentStep + 1) % cadSteps.length;
      renderCadStep(next);

      playLoopInterval = setInterval(() => {
        next = (next + 1) % cadSteps.length;
        renderCadStep(next);
      }, 3500);
    } else {
      btn?.classList.remove('playing');
      if (iconPlay) iconPlay.style.display = 'block';
      if (iconPause) iconPause.style.display = 'none';
      if (label) label.textContent = 'Lancer la simulation';

      if (playLoopInterval) clearInterval(playLoopInterval);
    }
  }

  function initCadIsoRoad() {
    renderCadStep(0);

    // Node click handlers
    [1, 2, 3, 4].forEach((num, i) => {
      const nodeGrp = document.getElementById(`nodeGroup${num}`);
      if (nodeGrp) {
        nodeGrp.addEventListener('click', () => {
          if (isPlaying) togglePlayPauseState(false);
          renderCadStep(i);
        });
      }
    });

    // Circular Play / Pause toggle
    const btnSim = document.getElementById('btnAutoDrive');
    if (btnSim) {
      btnSim.addEventListener('click', () => {
        togglePlayPauseState();
      });
    }

    // Scroll trigger
    const container = document.getElementById('isoRoadContainer');
    if (container && 'IntersectionObserver' in window) {
      let triggered = false;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !triggered) {
            triggered = true;
            setTimeout(() => {
              renderCadStep(1);
            }, 1000);
          }
        });
      }, { threshold: 0.35 });
      observer.observe(container);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCadIsoRoad);
  } else {
    initCadIsoRoad();
  }
</script>
