---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShareBar from '../../components/ShareBar.astro';
import AuthorSignature from '../../components/AuthorSignature.astro';
import { readingTimeLabel, readingTimeMinutes, tagHref } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingTime = readingTimeLabel(readingTimeMinutes(post.body ?? ''));

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/blog/${post.id}/`, siteUrl).href;
const ogImage = `/og/blog/${post.id}.png`;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const publishedTime = post.data.date.toISOString();

// Donnée structurée propre aux pages d'article.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: publishedTime,
  dateModified: publishedTime,
  inLanguage: 'fr-FR',
  keywords: post.data.tags.join(', '),
  image: ogImageUrl,
  author: {
    '@type': 'Person',
    name: 'Chesnel Ekogha',
    jobTitle: 'Ingénieur Cybersécurité Automobile',
    url: new URL('/', siteUrl).href,
  },
  publisher: {
    '@type': 'Person',
    name: 'Chesnel Ekogha',
    url: new URL('/', siteUrl).href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<Base
  title={post.data.title}
  description={post.data.excerpt}
  image={ogImage}
  ogType="article"
  publishedTime={publishedTime}
  schema={articleSchema}
>
  <article class="section prose" style="border-top: none;">
    <p><a href="/blog">&larr; Tous les articles</a></p>
    <p class="hero__eyebrow">{formatted} &middot; {readingTime}</p>
    <h1>{post.data.title}</h1>
    <div class="sheet__meta post__tags" style="margin-bottom: 1.5rem;">
      {post.data.tags.map((t: string) => (
        <a class="tag post__tag" href={tagHref(t)}>{t}</a>
      ))}
    </div>

    <!-- Top Share CTA -->
    <ShareBar title={post.data.title} />

    <Content />

    <!-- Author Signature Card (Verified Author) -->
    <AuthorSignature title={post.data.title} type="article" date={post.data.date} />

    <!-- Bottom Share CTA -->
    <ShareBar title={post.data.title} />
  </article>
</Base>

<style>
  .post__tags {
    gap: 0.45rem;
  }

  .post__tag {
    color: var(--ink-soft);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .post__tag:hover,
  .post__tag:focus-visible {
    border-color: var(--accent-cyan);
    color: var(--ink);
  }
</style>
