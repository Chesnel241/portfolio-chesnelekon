---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { collectTags, readingTimeMinutes } from '../../lib/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tags = collectTags(posts);
---

<Base title="Blog" description="Articles techniques de Chesnel Ekogha : cybersécurité automobile, infrastructure, retours d'expérience.">
  <section class="section" style="border-top: none;">
    <SectionHead label="posts" title="Articles" linkHref="/tags" linkLabel="Tous les tags →" />

    <!-- Filtre par tag (côté client) -->
    <div class="filter-bar" id="blogFilterBar" role="group" aria-label="Filtrer les articles par tag">
      <button type="button" class="btn btn--gradient filter-btn active" data-filter="all" aria-pressed="true">
        Tous les articles ({posts.length})
      </button>
      {tags.map(({ tag, count }) => (
        <button type="button" class="btn btn--outline filter-btn" data-filter={tag} aria-pressed="false">
          {tag} ({count})
        </button>
      ))}
    </div>

    <div class="timeline" id="postList">
      {posts.map((post) => (
        <ArticleRow
          slug={post.id}
          title={post.data.title}
          excerpt={post.data.excerpt}
          date={post.data.date}
          tags={post.data.tags}
          readingTime={readingTimeMinutes(post.body ?? '')}
        />
      ))}
    </div>

    <p class="blog-empty" id="blogEmpty" hidden>Aucun article ne correspond à ce tag.</p>
  </section>

  <script>
    const buttons = document.querySelectorAll('#blogFilterBar .filter-btn');
    const cards = document.querySelectorAll('#postList .article-row');
    const empty = document.getElementById('blogEmpty');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('btn--gradient', 'active');
          b.classList.add('btn--outline');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove('btn--outline');
        btn.classList.add('btn--gradient', 'active');
        btn.setAttribute('aria-pressed', 'true');

        const filter = btn.getAttribute('data-filter') ?? 'all';
        let visible = 0;

        cards.forEach((card) => {
          const cardTags = (card.getAttribute('data-tags') ?? '').split('|');
          const show = filter === 'all' || cardTags.includes(filter);
          (card as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible += 1;
        });

        if (empty) empty.hidden = visible > 0;
      });
    });
  </script>

  <style>
    .blog-empty {
      margin-top: 1.5rem;
      font-family: var(--font-mono);
      font-size: var(--fs-000);
      color: var(--ink-muted);
    }
  </style>
</Base>
